rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // USERNAMES MAPPING (Case-Insensitive Uniqueness)
    // ==========================================
    match /usernames/{usernameLowercase} {
      // Anyone authenticated can read username mappings to verify availability
      allow read: if isAuthenticated();
      // Only can create if not already taken and assigned to caller's UID
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      // Cannot modify existing username ownership
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ==========================================
    // USER PROFILES
    // ==========================================
    match /users/{userId} {
      // Any authenticated user can read public profile data (for discovery/social)
      allow read: if isAuthenticated();
      // Only the user themselves can write/update their profile
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ==========================================
    // LIKES & PASSES
    // ==========================================
    match /likes/{likeId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
    }

    match /passes/{passId} {
      allow read: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
    }

    // ==========================================
    // MATCHES
    // ==========================================
    match /matches/{matchId} {
      // Only matched participants can read match document
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.users);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.users);
    }

    // ==========================================
    // CONVERSATIONS & MESSAGES
    // ==========================================
    match /conversations/{conversationId} {
      // Only participants in conversation can read or update metadata
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow delete: if false;

      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if isAuthenticated();
        // Sender must be the authenticated user
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuthenticated() && resource.data.senderId == request.auth.uid;
      }
    }

    // ==========================================
    // BLOCKS & REPORTS
    // ==========================================
    match /blocks/{blockId} {
      allow read: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
      allow create, update: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false; // Only admin backend can access reports
    }

    // ==========================================
    // STORIES, REELS & BROADCASTS
    // ==========================================
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /reels/{reelId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /live_streams/{streamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }
  }
}
