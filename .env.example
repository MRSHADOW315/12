# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=DEFAULT_GEMINI_API_KEY

# FIREBASE CONFIGURATION (Optional alternative to google-services.json)
# If google-services.json is placed in /app/google-services.json, these are automatic.
# Alternatively, set these in AI Studio Secrets panel or .env:
FIREBASE_API_KEY=DEFAULT_FIREBASE_API_KEY
FIREBASE_APPLICATION_ID=DEFAULT_FIREBASE_APPLICATION_ID
FIREBASE_PROJECT_ID=DEFAULT_FIREBASE_PROJECT_ID
FIREBASE_STORAGE_BUCKET=DEFAULT_FIREBASE_STORAGE_BUCKET

